DATABASE_URL=postgresql://shms_user:shms_dev_password@127.0.0.1:5432/shms_dev
# Optional: tests default to the same server with database "shms_test"
# TEST_DATABASE_URL=postgresql://shms_user:shms_dev_password@127.0.0.1:5432/shms_test
JWT_SECRET=change_me
JWT_EXPIRY=30m
CLIENT_ORIGIN=http://localhost:5173
PORT=4000

# libuv thread pool (bcrypt hashing at cost 12 runs on it). server.js sets
# min(12, logical CPUs) unless this is set, here or in the process environment.
# The libuv default is 4, which queues concurrent logins.
# UV_THREADPOOL_SIZE=12

# Sign in with Google (optional). OAuth 2.0 Web client ID from Google Cloud
# Console. Leave blank to disable: the Google endpoints return 503 and the
# client hides the Google buttons. Google sign-in never creates accounts.
GOOGLE_CLIENT_ID=

# Messages a user may send per hour (default 30).
# MESSAGE_RATE_LIMIT=30
# Messages sent as Email or Both (supervisors and admins only) per user per hour (default 10).
# MESSAGE_EMAIL_RATE_LIMIT=10

# Shift reminders (server/src/jobs/reminders.js) tick every minute while the
# API runs (never under tests). Set REMINDERS_ENABLED=false to turn them off.
# Lead times in minutes; defaults shown.
# REMINDERS_ENABLED=true
# REMINDER_SHIFT_START_MINUTES=30          # before shift start, to assigned staff
# REMINDER_HANDOVER_DUE_FIRST_MINUTES=30   # before shift end, to assigned outgoing staff
# REMINDER_HANDOVER_DUE_FINAL_MINUTES=10   # before shift end, to assigned outgoing staff
# REMINDER_ACK_PENDING_MINUTES=15          # after the incoming shift starts, to the incoming user
# REMINDER_UNACK_ALERT_MINUTES=120         # after the incoming shift starts, to supervisors
# REMINDER_LOOKBACK_MINUTES=60             # reminders missed by more than this are not replayed

# ---- Email notifications (IR-05..IR-07) -------------------------------------
# Off unless EMAIL_ENABLED=true. The defaults point at the Mailpit container
# from docker-compose.yml (docker compose up -d mailpit; web UI on :8025),
# which catches everything and delivers nothing. Never commit real SMTP
# credentials: set them only in your own .env.
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Shift Handover <no-reply@shms.example>"
# Link put in every email (the client's address). Emails carry this link and a
# short title only, never handover content or passwords.
APP_URL=http://localhost:5173
# Comma-separated recipient domains. Any other domain is refused unless
# EMAIL_ALLOW_EXTERNAL=true. The seed accounts use shms.example.
EMAIL_ALLOWED_DOMAINS=shms.example
EMAIL_ALLOW_EXTERNAL=false
# Queued emails are sent by the jobs tick (every minute). A failed send is
# retried 3 times after base, 2 x base and 4 x base minutes, then marked
# failed on the notification.
# EMAIL_RETRY_BASE_MINUTES=1
# Notification types that may be emailed (comma-separated). Default:
# handover_submitted,handover_queried,handover_clarified,handover_escalated,
# handover_resolved,reminder,message ('message' only when the sender chose
# Email or Both). Users can turn email alerts off in their own menu.
# EMAIL_NOTIFICATION_TYPES=
