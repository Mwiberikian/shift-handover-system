DATABASE_URL=postgresql://shms_user:shms_dev_password@127.0.0.1:5432/shms_dev
# Optional: tests default to the same server with database "shms_test"
# TEST_DATABASE_URL=postgresql://shms_user:shms_dev_password@127.0.0.1:5432/shms_test
JWT_SECRET=change_me
JWT_EXPIRY=30m
CLIENT_ORIGIN=http://localhost:5173
PORT=4000

# Sign in with Google (optional). OAuth 2.0 Web client ID from Google Cloud
# Console. Leave blank to disable: the Google endpoints return 503 and the
# client hides the Google buttons. Google sign-in never creates accounts.
GOOGLE_CLIENT_ID=
