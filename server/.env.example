DATABASE_URL=postgresql://shms_user:shms_dev_password@127.0.0.1:5432/shms_dev
# Optional: tests default to the same server with database "shms_test"
# TEST_DATABASE_URL=postgresql://shms_user:shms_dev_password@127.0.0.1:5432/shms_test
JWT_SECRET=change_me
JWT_EXPIRY=30m
CLIENT_ORIGIN=http://localhost:5173
PORT=4000

# Sign in with Google (optional). OAuth 2.0 Web client ID from Google Cloud
# Console. Leave blank to disable: the Google endpoints return 503 and the
# client hides the Google buttons. Google sign-in never creates accounts.
GOOGLE_CLIENT_ID=

# Messages a user may send per hour (default 30).
# MESSAGE_RATE_LIMIT=30

# Shift reminders (server/src/jobs/reminders.js) tick every minute while the
# API runs (never under tests). Set REMINDERS_ENABLED=false to turn them off.
# Lead times in minutes; defaults shown.
# REMINDERS_ENABLED=true
# REMINDER_SHIFT_START_MINUTES=30          # before shift start, to assigned staff
# REMINDER_HANDOVER_DUE_FIRST_MINUTES=30   # before shift end, to assigned outgoing staff
# REMINDER_HANDOVER_DUE_FINAL_MINUTES=10   # before shift end, to assigned outgoing staff
# REMINDER_ACK_PENDING_MINUTES=15          # after the incoming shift starts, to the incoming user
# REMINDER_UNACK_ALERT_MINUTES=120         # after the incoming shift starts, to supervisors
# REMINDER_LOOKBACK_MINUTES=60             # reminders missed by more than this are not replayed
